# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store
nul

# Uploads & results (user-generated audio)
uploads/
results/
projects/
/music/
# 保存していない変更の、復旧用の写し (BUNRI_DATA_DIR を付けずに起動したとき、リポジトリ直下にできる)
/recovery/

# Soundfonts (large binary files)
soundfonts/
# 初めて使うときに取得する楽器の録音素材
/instruments/

# 追加の分離モデル（初回に自動でダウンロードされる）
/models/
*.safetensors

# PyTorch model cache
*.th
*.pt
*.pth

# Node.js (React フロントエンド)
node_modules/
web-ui/node_modules/

# React ビルド出力（ビルドで再生成可能）
web-ui/dist/

# Tauri (Rust のビルド出力と、ビルド時に生成されるスキーマ)
src-tauri/target/
src-tauri/gen/schemas/

# デスクトップ用の入口 (直下の package.json) の依存
/node_modules/

# デスクトップアプリに同梱する生成物 (scripts/prepare-desktop.mjs が用意する)
src-tauri/binaries/
src-tauri/runtime/

# 環境変数のファイル (API キーなどを書くことがあるので、コミットしない)
.env
.env.*

# ブラウザを自動操作するテスト (Playwright) の出力
web-ui/e2e-results/
web-ui/playwright-report/
# 本物の窓を操作するテスト (make e2e-desktop) の出力 (アプリのログ、最後の窓の画像)
web-ui/e2e-desktop-results/

# エージェントが作る別チェックアウト（このリポジトリの探索・検証からも除外する）
.claude/worktrees/

# 動きの記録（開発時の make desktop が書く。src-tauri/src/activity.rs）
/logs/
