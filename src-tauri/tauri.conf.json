{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bunri",
  "version": "0.1.0",
  "identifier": "io.github.suwakei.bunri",
  "build": {
    "frontendDist": "../backend/web/static/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix web-ui run dev -- --strictPort",
    "beforeBuildCommand": "npm --prefix web-ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "bunri",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* blob:",
        "media-src": "'self' blob: http://127.0.0.1:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
